{
  "appId": "com.vavol.openipcdashboard.intellect",
  "productName": "DASHBOARD for OpenIPC Intellect",
  "directories": {
    "output": "dist"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "OpenIPC",
      "repo": "dashboard"
    }
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "assets/icon.png"
  },
  "linux": {
    "target": "AppImage",
    "artifactName": "${productName}-${version}.${ext}",
    "icon": "assets/icon.png"
  },
  "mac": {
    "icon": "assets/icon.png"
  },
  "nsis": {
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}"
  },
  "extraResources": [
    {
      "from": "extra/analytics/",
      "to": "analytics"
    },
    {
      "from": "mediamtx/",
      "to": "mediamtx"
    },
    {
      "from": "runtime/license-plate/",
      "to": "runtime/license-plate"
    },
    {
      "from": "python_src/",
      "to": "python",
      "filter": [
        "license_plate_detection.onnx",
        "test_plate_yunet.py",
        "lpd_yunet.py",
        "lpd_yunet_ort.py",
        "plate_recognizer.py",
        "paddle_ocr_processor.py",
        "plate_api.py",
        "probe_ort_providers.py"
      ]
    }
  ],
  "files": [
    "**/*",
    "!python_src/",
    "!*.spec",
    "!builder-*.json",
    "!scripts/"
  ],
  "asarUnpack": [
    "**/node_modules/@ffmpeg-installer/ffmpeg/**",
    "**/node_modules/keytar/**"
  ],
  "generateUpdatesFilesForAllChannels": true
}