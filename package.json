{
  "name": "openipc-dashboard",
  "version": "2.8.7",
  "description": "App for managing OpenIPC cameras",
  "main": "src/main/main.js",
  "scripts": {
    "start": "chcp 65001 | electron .",
    "dist:lite": "node scripts/set-version.js lite && electron-builder --config builder-lite.json",
    "dist:intellect": "node scripts/set-version.js intellect && electron-builder --config builder-intellect.json",
    "dist": "npm run dist:intellect",
  "rebuild": "electron-rebuild"
    
  },
  "keywords": [],
  "author": "Rinibr",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenIPC/dashboard.git"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "OpenIPC",
        "repo": "dashboard"
      }
    ]
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@mhoc/axios-digest-auth": "^0.4.0",
    
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "async-mutex": "^0.5.0",
    "axios": "^1.6.8",
    "bonjour-service": "^1.3.0",
    "cors": "^2.8.5",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "express": "^4.21.2",
    "flatpickr": "^4.6.13",
    "fluent-ffmpeg": "^2.1.3",
    "get-port": "^7.1.0",
    "hls.js": "^1.5.8",
    "js-yaml": "^4.1.0",
    "keytar": "^7.9.0",
    "node-onvif": "^0.1.7",
    "promise-socket": "^8.0.0",
    "python-struct": "^1.1.3",
    "sharp": "^0.34.3",
    "ssh2": "^1.15.0",
    "systeminformation": "^5.27.7",
    "ws": "^8.17.1"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/OpenIPC/dashboard/issues"
  },
  "homepage": "https://github.com/OpenIPC/dashboard#readme"
}
