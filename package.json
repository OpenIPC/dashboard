{
  "name": "dashboard-for-openipc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "tauri": "tauri dev",
    "tauri-build": "tauri build",
    "download-mediamtx": "python tools/download-mediamtx.py",
    "build-release": "python tools/build.py",
    "build-debug": "python tools/build.py --debug",
    "build-windows": "python tools/build.py --platform windows",
    "build-linux": "python tools/build.py --platform linux",
    "build-macos": "python tools/build.py --platform macos"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.3.1",
    "@videojs/themes": "^1.0.1",
    "hls.js": "^1.6.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1",
    "video.js": "^8.23.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/hls.js": "^0.13.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/video.js": "^7.3.58",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "terser": "^5.44.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^5.0.3"
