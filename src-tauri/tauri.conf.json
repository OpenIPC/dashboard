{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dashboard",
  "version": "0.1.0",
  "identifier": "com.openipc.dashboard",
  "build": {
  "frontendDist": "../dist",
  "beforeBuildCommand": "npm run build",
  "devUrl": "http://localhost:5173",
  "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "VMS Dashboard",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true,
        "theme": "Dark",
        "devtools": true,
        "visible": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' ws: wss: http: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "mediamtx/*"
    ]
  }
}
