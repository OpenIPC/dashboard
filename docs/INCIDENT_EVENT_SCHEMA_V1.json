{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openipc.org/dashboard/schemas/incident-event-v1.json",
  "title": "OpenIPC Dashboard normalized incident event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "source",
    "sourceEventId",
    "category",
    "type",
    "severity",
    "occurredAtMs",
    "occurredAt",
    "receivedAt",
    "cameraId",
    "cameraIp",
    "siteId",
    "areaId",
    "actor",
    "title",
    "message",
    "evidence",
    "attributes",
    "correlationKey",
    "fingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sourceEventId": { "type": "string", "maxLength": 240 },
    "source": { "type": "string", "minLength": 1, "maxLength": 80 },
    "category": { "type": "string", "minLength": 1, "maxLength": 80 },
    "type": { "type": "string", "minLength": 1, "maxLength": 120 },
    "severity": { "enum": ["info", "warning", "error", "critical"] },
    "occurredAtMs": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "receivedAt": { "type": "string", "format": "date-time" },
    "cameraId": { "type": "string", "maxLength": 200 },
    "cameraIp": { "type": "string", "maxLength": 120 },
    "siteId": { "type": "string", "maxLength": 200 },
    "areaId": { "type": "string", "maxLength": 200 },
    "actor": { "type": "string", "maxLength": 160 },
    "title": { "type": "string", "maxLength": 240 },
    "message": { "type": "string", "maxLength": 2000 },
    "evidence": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": ["object", "string", "number", "boolean", "null"] }
    },
    "attributes": { "type": "object", "maxProperties": 64 },
    "correlationKey": { "type": "string", "minLength": 1, "maxLength": 300 },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
